<script>
    function soloNumeros(e)
        {
            var key = window.Event ? e.which : e.keyCode;
            //alert(key);
            return ((key >= 48 && key <= 57) || key == 0 || key == 8)// || key == 45)
        }
        
    /*
     Please consider that the JS part isn't production ready at all, I just code it to show the concept of merging filters and titles together !
     */
    $(document).ready(function () {
        $("#id_requerimiento").select2({
            width: 'resolve' // need to override the changed default
        });
        
        $('#fecha_entrada').click(function () {
            var fechaVencimientoIni = $('#fecha_entrada').val();
            $('#fecha_entrada').change(function () {
                var fechaVencimiento = $('#fecha_entrada').val();
                f1 = fechaVencimiento.split("-");
                f3 = new Date();
                var f1 = new Date(parseInt(f1[2]), parseInt(f1[1] - 1), parseInt(f1[0], 0, 0,59));
                
                if (f1 > f3) {
                    bootbox.alert("La Fecha de Pecosa no debe ser mayor a la Fecha Actual");
                    
                    $('#fecha_entrada').val(fechaVencimientoIni);
                    return false;
                }
            });
        });
        $('#fecha_entrada').trigger('change');
        
    });
    
    $("#btnReg").on("click", function () {
        var hoy = new Date();
        var dd = hoy.getDate();
        var mm = hoy.getMonth()+1; //hoy es 0!
        var yyyy = hoy.getFullYear();   
        if(dd<10) {
            dd='0'+dd
        } 
        if(mm<10) {
            mm='0'+mm
        }
        hoy = dd+'-'+mm+'-'+yyyy;        
        fecha_entrada=$('#frmPecosa').find("#fecha_entrada").val();                        
        var xMonth=fecha_entrada.substring(3, 5);                 
        var xDay=fecha_entrada.substring(0, 2);  
        var xYear=fecha_entrada.substring(6,10);  
        var yMonth=hoy.substring(3, 5);          
        var yDay=hoy.substring(0, 2);  
        var yYear=hoy.substring(6,10);         
        if (xYear> yYear) {  
                alert("La fecha solo puede estar comprendida entre hoy y 30 días atrás");
                return false; 
            }
        else{
            if (xYear == yYear){
                if (xMonth> yMonth){
                    alert("La fecha solo puede estar comprendida entre hoy y 30 días atrás");
                    return false;  
                }
                else{
                    if (xMonth == yMonth){
                        if (xDay> yDay){
                            alert("La fecha solo puede estar comprendida entre hoy y 30 días atrás");
                            return false;
                        }
                    }
                }
            }
        }
			
            if ($('#frmPecosa').find("#id_requerimiento").val() == 0 || $('#frmPecosa').find("#id_requerimiento").val() == "") {
                alert("Falta Seleccionar el requerimiento");
                return false;
            }

            if ($('#frmPecosa').find("#numero").val() == "") {
                alert("Falta digitar el número de pecosa");
                return false;
            }
			
            if ($('#frmPecosa').find("#fecha_entrada").val() == "") {
                alert("Falta Seleccionar la Fecha");
                return false;
            } 


    });

    function select_tipoing() {
            $("#id_requerimiento").val('');
            $('#id_requerimiento').trigger('change');
            $("#numero").val('');
            $("#fecha_entrada").val('');
        
        if ($("#id_origen").val() == "") {
            $('#id_requerimiento').attr('disabled', true);
            $('#numero').attr('disabled', true);
            $('#ano').attr('disabled', true);
            $('#fecha_entrada').attr('disabled', true);
        } else {
            $('#id_requerimiento').attr('disabled', false);
            $('#numero').attr('disabled', false);
            $('#ano').attr('disabled', false);
            $('#fecha_entrada').attr('disabled', false);
            getRequerimiento();
        }
    }
    
    function getRequerimiento() {

        var id_origen = $('#id_origen').val();
        $.ajax({
            url: '/obtener_nroreque_por_id_origen/' + id_origen,
            success: function (result) {
                var newOption = "";
                newOption = "<option value='0'>--Seleccione-</option>";
                $(result).each(function (ii, oo) {
                    newOption += "<option value='" + oo.id_reque + "'>" + oo.nro_reque + "-" + oo.anio_reque +"</option>";
                });
                $('#id_requerimiento').html(newOption);
                $("#id_requerimiento").select2({max_selected_options: 4});
                $('#id_requerimiento').attr('disabled', false);
                $('#id_requerimiento').attr('required', true);

            }
        });

    }
    
    (function () {
        'use strict';
        var $ = jQuery;
        $.fn.extend({
            filterTable: function () {
                return this.each(function () {
                    $(this).on('keyup', function (e) {
                        $('.filterTable_no_results').remove();
                        var $this = $(this),
                                search = $this.val().toLowerCase(),
                                target = $this.attr('data-filters'),
                                $target = $(target),
                                $rows = $target.find('tbody tr');

                        if (search == '') {
                            $rows.show();
                        } else {
                            $rows.each(function () {
                                var $this = $(this);
                                $this.text().toLowerCase().indexOf(search) === -1 ? $this.hide() : $this.show();
                            })
                            if ($target.find('tbody tr:visible').size() === 0) {
                                var col_count = $target.find('tr').first().find('td').size();
                                var no_results = $('<tr class="filterTable_no_results"><td colspan="' + col_count + '">No hay resultados</td></tr>')
                                $target.find('tbody').append(no_results);
                            }
                        }
                    });
                });
            }
        });
        $('[data-action="filter"]').filterTable();
    })(jQuery);

</script>
@endsection
