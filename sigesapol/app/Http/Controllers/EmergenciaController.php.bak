          $dia = substr($fecha, 6, 2);
          $fechaFormateada = "$dia/$mes/$anio";

          switch ($beneficiario_ajax->nomtipdocafiliado) {
            case 'DNI':
              $id_tipo_doc_ident = 1;
              break;
            case 'CE':
              $id_tipo_doc_ident = 2;
