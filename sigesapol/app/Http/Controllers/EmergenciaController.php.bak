    $date = Carbon::now();
    $hora=$date->toTimeString(); 

    if($hora>'01:30' & $hora<'07:31'):
      /*echo*/ $turno='MD';
    else:
      if($hora>'07:30' & $hora<'13:31'):
        /*echo*/ $turno='M';
      else:
        if($hora>'13:30' & $hora<'19:31'):
          /*echo*/ $turno='T';
        else:
          if($hora>'19:30' & $hora<='23:59'):
            /*echo*/ $turno='N';
          else:
            if($hora>='00:00' & $hora<='01:31'):
              /*echo*/ $turno='N';
            endif;
          endif;
        endif;
      endif;
