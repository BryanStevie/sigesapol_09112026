        $ruta = Route::getCurrentRoute()->getPath();
        if (count($ruta = explode("/", $ruta)) > 1)
            ;$ruta = $ruta[0];
        if($ruta=="listar_triaje_emergencia_ajax");$ruta="all_admisiones_atendidas_by_emergencia";
